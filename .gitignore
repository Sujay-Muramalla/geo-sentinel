# --- OS junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# --- VS Code ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments (IMPORTANT for your Mac/Win dual machine workflow)
.venv/
venv/
ENV/
env/

# Jupyter
.ipynb_checkpoints/

# --- Node / frontend/backend (if using npm/yarn/pnpm) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# --- Terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
.terraformrc
terraform.rc

# Optional: keep lock file tracked (recommended)
!**/.terraform.lock.hcl

# tfvars often contain secrets - keep them local unless you explicitly want templates
*.tfvars
*.tfvars.json

# But allow example templates to be committed
!*.tfvars.example

# --- Environment files / secrets ---
.env
.env.*
!.env.example

# --- Logs ---
*.log

# --- IDEs ---
.idea/
*.iml
